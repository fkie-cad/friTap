{
    "name": "friTap",
    "version": "2.6.5",
    "description": "Frida agent for logging encrypted traffic as plaintext and extracting its encryption keys",
    "private": true,
    "main": "agent/fritap_agent.ts",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "prepare": "npm run build",
        "build": "frida-compile agent/fritap_agent.ts -o friTap/fritap_agent.js",
        "build:memscan": "frida-compile agent/memory_scan_agent.ts -o friTap/fritap_memscan.js",
        "build:full": "./dev/compile_agent.sh full",
        "watch": "frida-compile agent/fritap_agent.ts -o friTap/_fritap_agent.js -w",
        "test:agent": "node --import tsx --test \"agent/**/*.test.ts\"",
        "test:memscan-agent": "node tests/agent/mtproto_agent_harness.mjs"
    },
    "keywords": [
        "frida",
        "runtime",
        "mobile",
        "security",
        "friTap"
    ],
    "devDependencies": {
        "@types/frida-gum": "19.10.0",
        "@types/node": "^18",
        "@types/source-map-support": "^0.5.6",
        "frida-compile": "19.0.5",
        "source-map": "^0.7.4",
        "tsx": "^4.19.2",
        "typescript": "5.8.2"
    },
    "dependencies": {
        "frida": "^17.8.0",
        "frida-java-bridge": "git+https://github.com/frida/frida-java-bridge.git#b38a5b647d3e6b72aa19bcf8eb5e41c550a0e622",
        "frida-objc-bridge": "^8.0.6",
        "util": "^0.12.5"
    }
}
