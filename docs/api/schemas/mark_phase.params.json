{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "label": {
      "description": "Short phase name, lower-case and hyphenated (e.g. consent-declined). diff phase_a/phase_b must match it exactly.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "session_id": {
      "description": "Id returned by start_capture.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "label"
  ],
  "title": "mark_phase parameters",
  "type": "object"
}
